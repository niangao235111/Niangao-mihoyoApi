# 服务器环境变量示例；复制为backend.env并填入值，不要把真实文件上传到仓库。
# 可供systemd EnvironmentFile或bash source读取；不要使用空格包围等号。
DB_URL='jdbc:mysql://127.0.0.1:3306/genshinImpact?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true'
DB_USERNAME='replace_with_database_user'
DB_PASSWORD='replace_with_database_password'
REDIS_HOST='127.0.0.1'
REDIS_PORT='6379'
REDIS_DATABASE='1'
REDIS_USERNAME='default'
REDIS_PASSWORD='replace_with_redis_password'
FRONTEND_URL='https://your-workbench.example'
WORKBENCH_ALLOWED_ORIGINS='https://your-workbench.example'
MIHOYO_PHONE_KEY_SECRET='replace_with_stable_random_secret'
# 祈愿授权使用独立 DS1，版本与 LK2 盐必须配对；默认来自 UIGF 2.71.1 资料。
GENSHIN_WISH_AUTH_APP_VERSION='2.71.1'
GENSHIN_WISH_AUTH_DS_SALT='EJncUPGnOHajenjLhBOsdpwEMZmiCmQX'
GENSHIN_WISH_PAGE_DELAY_MS='750'
WORKBENCH_ENCRYPTION_KEY='replace_with_32_random_bytes_in_base64'
